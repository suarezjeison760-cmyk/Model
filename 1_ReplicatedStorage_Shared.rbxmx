<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="Folder" referent="RBX1">
    <Properties>
      <string name="Name">Shared</string>
    </Properties>
    <Item class="Folder" referent="RBX2">
      <Properties>
        <string name="Name">Maps</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX3">
        <Properties>
          <string name="Name">ArcticTemple</string>
          <ProtectedString name="Source"><![CDATA[--[[
	ArcticTemple.lua — MAPA 2
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > ArcticTemple   (ModuleScript)

	Tema: Templo Ártico / Hielo Cristalino Stud.
	Suelo resbaladizo, templo central de 3 niveles, cristales gigantes,
	grietas de agua helada y puentes de hielo estrechos.
]]

local Build = require(script.Parent.Parent.Build)
local Palette = require(script.Parent.Parent.Palette)
local MapKit = require(script.Parent.MapKit)

local Map = {}

Map.Id = "arctic"
Map.Name = "TEMPLO ÁRTICO"
Map.Theme = "Hielo Cristalino Stud"
Map.Description = "Hielo resbaladizo, cristales turquesa y caídas al agua helada."
Map.Colors = {
	Primary = Color3.fromRGB(214, 240, 255),
	Secondary = Color3.fromRGB(86, 196, 255),
	Accent = Color3.fromRGB(0, 236, 226),
}
Map.Lighting = {
	ClockTime = 9.5, Brightness = 2.8,
	Ambient = Color3.fromRGB(120, 150, 170), OutdoorAmbient = Color3.fromRGB(150, 180, 200),
	FogColor = Color3.fromRGB(200, 228, 245), FogEnd = 1100,
	AtmosphereColor = Color3.fromRGB(205, 232, 255), AtmosphereDensity = 0.36,
	AtmosphereHaze = 1.6, AtmosphereTint = Color3.fromRGB(225, 245, 255),
}

local ICE_PHYSICS = PhysicalProperties.new(0.7, 0.08, 0.2, 1, 1) -- fricción muy baja

function Map.Build(origin: Vector3, rng: Random): (Model, { CFrame })
	local model = Build.model("Map_" .. Map.Id)
	local ice = Map.Colors.Primary
	local deep = Map.Colors.Secondary
	local crystal = Map.Colors.Accent

	-- Plataforma helada principal (resbaladiza)
	local floor = Build.part({
		Name = "IceField", Size = Vector3.new(320, 8, 320), Color = ice,
		Position = origin + Vector3.new(0, 4, 0), Shadow = true,
	}, model)
	floor.CustomPhysicalProperties = ICE_PHYSICS

	-- Agua helada perimetral (daño por congelación)
	MapKit.hazard(model, CFrame.new(origin + Vector3.new(0, 1, 0)), Vector3.new(560, 4, 560), deep, 16, {
		Name = "FrozenWater", Transparency = 0.35, CanCollide = true, Material = Enum.Material.Glass, Interval = 0.4,
	})

	-- Grietas en el hielo (agujeros letales)
	for i = 1, 8 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(55, 140)
		MapKit.hazard(model, CFrame.new(origin + Vector3.new(math.cos(ang) * r, 8.3, math.sin(ang) * r)) * CFrame.Angles(0, ang, 0),
			Vector3.new(rng:NextNumber(14, 30), 0.6, rng:NextNumber(8, 16)), deep, 14,
			{ Name = "Crack", Transparency = 0.25, Interval = 0.5 })
	end

	-- Templo central de 3 niveles con columnas
	local levels = 3
	for lv = 1, levels do
		local w = 120 - (lv - 1) * 34
		local y = 8 + (lv - 1) * 16
		Build.part({
			Name = "TempleFloor", Size = Vector3.new(w, 4, w),
			Color = Palette.vary(ice, 0.01, 0.03, 0.04, rng),
			Position = origin + Vector3.new(0, y + 2, 0), Shadow = lv == 1,
		}, model)
		local cols = 8
		for i = 1, cols do
			local ang = (i / cols) * math.pi * 2
			local r = w / 2 - 7
			MapKit.pillar(model, origin + Vector3.new(math.cos(ang) * r, y + 4, math.sin(ang) * r), 14, 4,
				Palette.darken(ice, 0.12), crystal)
		end
		-- escalinata de acceso
		MapKit.stairs(model, CFrame.new(origin + Vector3.new(0, y, w / 2 + 2)), 8, Vector3.new(16, 2, 2.6), Palette.darken(ice, 0.06))
	end

	-- Altar y cristal maestro
	local topY = 8 + levels * 16
	Build.part({ Name = "Altar", Size = Vector3.new(22, 3, 22), Color = Palette.darken(ice, 0.2),
		Position = origin + Vector3.new(0, topY + 1.5, 0) }, model)
	local master = Build.neon({ Name = "MasterCrystal", Size = Vector3.new(8, 26, 8), Color = crystal,
		Transparency = 0.25, CanCollide = false,
		CFrame = CFrame.new(origin + Vector3.new(0, topY + 16, 0)) * CFrame.Angles(0, math.rad(45), 0) }, model)
	Build.light(master, crystal, 55, 4)

	-- Cristales gigantes repartidos
	for i = 1, 16 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(70, 150)
		local h = rng:NextNumber(14, 34)
		local pos = origin + Vector3.new(math.cos(ang) * r, 8 + h / 2, math.sin(ang) * r)
		local c = Palette.vary(crystal, 0.05, 0.1, 0.12, rng)
		Build.part({
			Name = "Crystal", Size = Vector3.new(rng:NextNumber(4, 9), h, rng:NextNumber(4, 9)),
			Color = c, Material = Enum.Material.Glass, Transparency = 0.35, Stud = false,
			CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.18, 0.18), rng:NextNumber(0, 6), rng:NextNumber(-0.18, 0.18)),
		}, model)
		if i % 4 == 0 then
			local tip = Build.neon({ Name = "CrystalTip", Size = Vector3.new(3, 4, 3), Color = c, CanCollide = false,
				Position = pos + Vector3.new(0, h / 2 + 2, 0) }, model)
			Build.light(tip, c, 24, 2)
		end
	end

	-- Puentes de hielo flotantes entre islotes
	for i = 1, 4 do
		local ang = (i / 4) * math.pi * 2 + math.pi / 4
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local islandPos = origin + dir * 135 + Vector3.new(0, 20, 0)
		MapKit.island(model, islandPos, 22, 4, ice, deep)
		for s = 1, 6 do
			local p = Build.part({
				Name = "IceBridge", Size = Vector3.new(8, 1.2, 10), Color = Palette.lighten(ice, 0.05),
				Transparency = 0.1,
				CFrame = CFrame.new(origin + dir * (62 + s * 11) + Vector3.new(0, 11 + s * 1.6, 0)) * CFrame.Angles(0, -ang, 0),
			}, model)
			p.CustomPhysicalProperties = ICE_PHYSICS
		end
	end

	MapKit.totem(model, CFrame.new(origin + Vector3.new(0, 8, 130)), "TEMPLO ÁRTICO", crystal)
	MapKit.voidPlane(model, origin, 900, -40)

	local spawns = MapKit.spawnRing(origin, 118, 12, 12)
	return model, spawns
end

return Map
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">CyberCity</string>
          <ProtectedString name="Source"><![CDATA[--[[
	CyberCity.lua — MAPA 5
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > CyberCity   (ModuleScript)

	Tema: Ciudad Futurista / Cibernética Stud.
	Rejilla neón, torres con ventanas iluminadas, pasarelas elevadas,
	muros láser que hacen daño y plataformas de salto (jump pads).
]]

local Build = require(script.Parent.Parent.Build)
local Palette = require(script.Parent.Parent.Palette)
local MapKit = require(script.Parent.MapKit)

local Map = {}

Map.Id = "cyber"
Map.Name = "CIUDAD FUTURISTA"
Map.Theme = "Cibernética Stud"
Map.Description = "Rascacielos neón, pasarelas altas y muros láser en movimiento."
Map.Colors = {
	Primary = Color3.fromRGB(32, 36, 64),
	Secondary = Color3.fromRGB(255, 52, 190),
	Accent = Color3.fromRGB(0, 238, 255),
}
Map.Lighting = {
	ClockTime = 0.4, Brightness = 1.2,
	Ambient = Color3.fromRGB(40, 44, 80), OutdoorAmbient = Color3.fromRGB(54, 58, 104),
	FogColor = Color3.fromRGB(24, 20, 56), FogEnd = 640,
	AtmosphereColor = Color3.fromRGB(60, 56, 130), AtmosphereDensity = 0.46,
	AtmosphereHaze = 3.0, AtmosphereTint = Color3.fromRGB(150, 120, 255),
}

function Map.Build(origin: Vector3, rng: Random): (Model, { CFrame })
	local model = Build.model("Map_" .. Map.Id)
	local dark = Map.Colors.Primary
	local pink = Map.Colors.Secondary
	local cyan = Map.Colors.Accent

	-- Plaza base + rejilla neón
	Build.part({ Name = "Ground", Size = Vector3.new(320, 8, 320), Color = dark,
		Position = origin + Vector3.new(0, 4, 0), Shadow = true }, model)
	for i = -7, 7 do
		Build.neon({ Name = "GridX", Size = Vector3.new(320, 0.3, 1), Color = (i % 2 == 0) and cyan or pink,
			Transparency = 0.45, CanCollide = false, Position = origin + Vector3.new(0, 8.2, i * 22) }, model)
		Build.neon({ Name = "GridZ", Size = Vector3.new(1, 0.3, 320), Color = (i % 2 == 0) and pink or cyan,
			Transparency = 0.45, CanCollide = false, Position = origin + Vector3.new(i * 22, 8.2, 0) }, model)
	end

	-- Torres con ventanas neón
	local towerSpots = {
		Vector3.new(-96, 0, -96), Vector3.new(96, 0, -96), Vector3.new(-96, 0, 96), Vector3.new(96, 0, 96),
		Vector3.new(0, 0, -124), Vector3.new(0, 0, 124), Vector3.new(-128, 0, 0), Vector3.new(128, 0, 0),
	}
	for idx, spot in ipairs(towerSpots) do
		local h = rng:NextNumber(46, 96)
		local w = rng:NextNumber(24, 36)
		local base = origin + spot
		Build.part({ Name = "Tower", Size = Vector3.new(w, h, w), Color = Palette.vary(dark, 0.02, 0.06, 0.07, rng),
			Position = base + Vector3.new(0, 8 + h / 2, 0), Shadow = true }, model)
		-- ventanas
		local rows = math.floor(h / 10)
		for r = 1, rows do
			for _, face in ipairs({ Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) }) do
				if rng:NextNumber() < 0.65 then
					local color = (rng:NextNumber() < 0.5) and cyan or pink
					local size = (face.X ~= 0) and Vector3.new(0.4, 3.4, w * 0.5) or Vector3.new(w * 0.5, 3.4, 0.4)
					Build.neon({
						Name = "Window", Size = size, Color = color, Transparency = 0.25, CanCollide = false,
						Position = base + Vector3.new(0, 8 + r * 10, 0) + face * (w / 2 + 0.1),
					}, model)
				end
			end
		end
		-- azotea accesible
		Build.part({ Name = "Roof", Size = Vector3.new(w + 6, 2, w + 6), Color = Palette.darken(dark, 0.08),
			Position = base + Vector3.new(0, 8 + h + 1, 0) }, model)
		local beacon = Build.neon({ Name = "Beacon", Size = Vector3.new(3, 6, 3), Color = (idx % 2 == 0) and pink or cyan,
			CanCollide = false, Position = base + Vector3.new(0, 8 + h + 5, 0) }, model)
		Build.light(beacon, beacon.Color, 40, 3)
	end

	-- Pasarelas elevadas que conectan torres
	for i = 1, #towerSpots do
		local a = origin + towerSpots[i]
		local b = origin + towerSpots[(i % #towerSpots) + 1]
		local mid = (a + b) / 2
		local dir = (b - a)
		local len = dir.Magnitude
		Build.part({
			Name = "Skywalk", Size = Vector3.new(9, 1.4, len * 0.78), Color = Palette.darken(dark, 0.05),
			CFrame = CFrame.lookAt(mid + Vector3.new(0, 48, 0), b + Vector3.new(0, 48, 0)),
		}, model)
		Build.neon({
			Name = "SkywalkEdge", Size = Vector3.new(10, 0.3, len * 0.78), Color = cyan, Transparency = 0.35, CanCollide = false,
			CFrame = CFrame.lookAt(mid + Vector3.new(0, 48.9, 0), b + Vector3.new(0, 48.9, 0)),
		}, model)
	end

	-- Plataforma central elevada (zona caliente)
	Build.part({ Name = "Hub", Size = Vector3.new(58, 3, 58), Color = Palette.darken(dark, 0.1),
		Position = origin + Vector3.new(0, 30, 0), Shadow = true }, model)
	Build.ring(origin + Vector3.new(0, 32.5, 0), 27, 16, Vector3.new(3, 3, 3), pink, model)
	for _, s in ipairs({ -1, 1 }) do
		MapKit.ramp(model, CFrame.new(origin + Vector3.new(s * 40, 19, 0)) * CFrame.Angles(0, math.rad(s * 90), 0),
			Vector3.new(14, 22, 30), Palette.darken(dark, 0.04))
	end

	-- Jump pads
	for i = 1, 6 do
		local ang = (i / 6) * math.pi * 2
		MapKit.bouncy(model, CFrame.new(origin + Vector3.new(math.cos(ang) * 62, 8.6, math.sin(ang) * 62)),
			Vector3.new(12, 1.2, 12), cyan, 150)
	end

	-- Muros láser (daño alto, pasillos peligrosos)
	for i = 1, 5 do
		local x = (i - 3) * 40
		MapKit.hazard(model, CFrame.new(origin + Vector3.new(x, 16, 0)), Vector3.new(2, 16, 46), pink, 26,
			{ Name = "LaserWall", Transparency = 0.45, Interval = 0.3 })
	end

	-- Hologramas publicitarios
	for i = 1, 4 do
		local ang = (i / 4) * math.pi * 2 + math.pi / 4
		local pos = origin + Vector3.new(math.cos(ang) * 110, 36, math.sin(ang) * 110)
		Build.sign(CFrame.lookAt(pos, Vector3.new(origin.X, pos.Y, origin.Z)),
			(i % 2 == 0) and "<b>STUD</b> CORP" or "NEO <b>BLOX</b>",
			{ Width = 30, Height = 10, Color = dark, Accent = (i % 2 == 0) and cyan or pink }, model)
	end

	MapKit.totem(model, CFrame.new(origin + Vector3.new(0, 8, 132)), "CIUDAD FUTURISTA", cyan)
	MapKit.voidPlane(model, origin, 900, -40)

	local spawns = MapKit.spawnRing(origin, 104, 12, 14)
	return model, spawns
end

return Map
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">DesertRuins</string>
          <ProtectedString name="Source"><![CDATA[--[[
	DesertRuins.lua — MAPA 4
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > DesertRuins   (ModuleScript)

	Tema: Ruinas del Desierto / Pirámides Stud.
	Tres pirámides escalonadas (una escalable hasta la cima), obeliscos,
	columnas rotas, arenas movedizas y un oasis central.
]]

local Build = require(script.Parent.Parent.Build)
local Palette = require(script.Parent.Parent.Palette)
local MapKit = require(script.Parent.MapKit)

local Map = {}

Map.Id = "desert"
Map.Name = "RUINAS DEL DESIERTO"
Map.Theme = "Pirámides Stud"
Map.Description = "Pirámides escalables, obeliscos dorados y arenas movedizas."
Map.Colors = {
	Primary = Color3.fromRGB(240, 206, 126),
	Secondary = Color3.fromRGB(196, 150, 84),
	Accent = Color3.fromRGB(255, 196, 40),
}
Map.Lighting = {
	ClockTime = 15.0, Brightness = 3.0,
	Ambient = Color3.fromRGB(130, 112, 80), OutdoorAmbient = Color3.fromRGB(170, 146, 102),
	FogColor = Color3.fromRGB(236, 206, 150), FogEnd = 1000,
	AtmosphereColor = Color3.fromRGB(238, 212, 160), AtmosphereDensity = 0.40,
	AtmosphereHaze = 2.2, AtmosphereTint = Color3.fromRGB(255, 232, 190),
}

local function pyramid(parent: Instance, base: Vector3, size: number, steps: number, color: Color3, accent: Color3, rng: Random)
	for i = 1, steps do
		local w = size * (1 - (i - 1) / steps)
		Build.part({
			Name = "PyramidStep", Size = Vector3.new(w, 7, w),
			Color = Palette.vary(color, 0.01, 0.04, 0.05, rng),
			Position = base + Vector3.new(0, (i - 0.5) * 7, 0),
			Shadow = i <= 2,
		}, parent)
	end
	local topY = steps * 7
	local cap = Build.neon({
		Name = "Capstone", Size = Vector3.new(8, 8, 8), Color = accent, CanCollide = true,
		CFrame = CFrame.new(base + Vector3.new(0, topY + 4, 0)) * CFrame.Angles(0, math.rad(45), 0),
	}, parent)
	Build.light(cap, accent, 40, 3)
end

function Map.Build(origin: Vector3, rng: Random): (Model, { CFrame })
	local model = Build.model("Map_" .. Map.Id)
	local sand = Map.Colors.Primary
	local stone = Map.Colors.Secondary
	local gold = Map.Colors.Accent

	-- Desierto
	Build.part({ Name = "Sand", Size = Vector3.new(360, 8, 360), Color = sand,
		Position = origin + Vector3.new(0, 4, 0), Shadow = true }, model)

	-- Dunas (cuñas grandes, muy barato)
	for i = 1, 10 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(90, 165)
		local s = rng:NextNumber(22, 46)
		Build.wedge({
			Name = "Dune", Size = Vector3.new(s, s * 0.42, s * 1.5),
			Color = Palette.vary(sand, 0.01, 0.05, 0.06, rng),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(ang) * r, 8 + s * 0.21, math.sin(ang) * r))
				* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
		}, model)
	end

	-- Pirámide mayor (escalable) + dos menores
	pyramid(model, origin + Vector3.new(0, 8, -55), 104, 9, stone, gold, rng)
	pyramid(model, origin + Vector3.new(-98, 8, 68), 62, 6, stone, gold, rng)
	pyramid(model, origin + Vector3.new(98, 8, 68), 62, 6, stone, gold, rng)

	-- Oasis central con plataforma
	Build.neon({ Name = "Oasis", Size = Vector3.new(40, 1, 40), Color = Color3.fromRGB(60, 220, 230),
		Transparency = 0.4, Shape = Enum.PartType.Cylinder, CanCollide = true,
		CFrame = CFrame.new(origin + Vector3.new(0, 8.4, 60)) * CFrame.Angles(0, 0, math.rad(90)) }, model)
	MapKit.pillar(model, origin + Vector3.new(0, 9, 60), 18, 5, stone, gold)

	-- Obeliscos
	for i = 1, 6 do
		local ang = (i / 6) * math.pi * 2
		local r = 84
		local pos = origin + Vector3.new(math.cos(ang) * r, 8, math.sin(ang) * r)
		Build.part({ Name = "Obelisk", Size = Vector3.new(7, 34, 7), Color = stone,
			CFrame = CFrame.new(pos + Vector3.new(0, 17, 0)) * CFrame.Angles(0, ang, 0), Shadow = true }, model)
		Build.neon({ Name = "ObeliskTip", Size = Vector3.new(5, 6, 5), Color = gold, CanCollide = false,
			CFrame = CFrame.new(pos + Vector3.new(0, 37, 0)) * CFrame.Angles(0, ang, math.rad(45)) }, model)
	end

	-- Columnas rotas (cobertura)
	for i = 1, 16 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(40, 150)
		local h = rng:NextNumber(6, 22)
		Build.cylinder({
			Name = "Column", Size = Vector3.new(h, 7, 7), Color = Palette.vary(stone, 0.01, 0.04, 0.07, rng),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(ang) * r, 8 + h / 2, math.sin(ang) * r))
				* CFrame.Angles(0, rng:NextNumber(0, 6), math.rad(90)),
		}, model)
	end

	-- Muros de ruinas que forman pasillos
	for i = 1, 8 do
		local ang = (i / 8) * math.pi * 2 + math.pi / 10
		local r = 122
		local pos = origin + Vector3.new(math.cos(ang) * r, 8, math.sin(ang) * r)
		Build.part({ Name = "RuinWall", Size = Vector3.new(34, rng:NextNumber(10, 20), 4),
			Color = Palette.darken(stone, 0.07),
			CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)) * CFrame.Angles(0, -ang, 0) }, model)
	end

	-- Arenas movedizas (daño lento)
	for i = 1, 6 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(50, 140)
		MapKit.hazard(model, CFrame.new(origin + Vector3.new(math.cos(ang) * r, 8.2, math.sin(ang) * r)),
			Vector3.new(rng:NextNumber(16, 28), 0.6, rng:NextNumber(16, 28)), Palette.darken(sand, 0.3), 9,
			{ Name = "Quicksand", Transparency = 0.1, Material = Enum.Material.SmoothPlastic, Interval = 0.6 })
	end

	MapKit.totem(model, CFrame.new(origin + Vector3.new(0, 8, 140)), "RUINAS DEL DESIERTO", gold)
	MapKit.voidPlane(model, origin, 900, -40)

	local spawns = MapKit.spawnRing(origin, 126, 12, 12)
	return model, spawns
end

return Map
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">EnchantedForest</string>
          <ProtectedString name="Source"><![CDATA[--[[
	EnchantedForest.lua — MAPA 3
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > EnchantedForest   (ModuleScript)

	Tema: Bosque Encantado / Setas Neón Stud.
	Setas gigantes que rebotan, árboles procedurales violeta/magenta,
	laguna brillante, troncos caídos y plataformas de copa a 3 alturas.
]]

local Build = require(script.Parent.Parent.Build)
local Palette = require(script.Parent.Parent.Palette)
local TreeGenerator = require(script.Parent.Parent.TreeGenerator)
local MapKit = require(script.Parent.MapKit)

local Map = {}

Map.Id = "forest"
Map.Name = "BOSQUE ENCANTADO"
Map.Theme = "Setas Neón Stud"
Map.Description = "Setas que te lanzan por los aires y niebla mágica violeta."
Map.Colors = {
	Primary = Color3.fromRGB(64, 182, 108),
	Secondary = Color3.fromRGB(186, 92, 255),
	Accent = Color3.fromRGB(150, 255, 80),
}
Map.Lighting = {
	ClockTime = 20.2, Brightness = 1.6,
	Ambient = Color3.fromRGB(70, 56, 96), OutdoorAmbient = Color3.fromRGB(90, 70, 120),
	FogColor = Color3.fromRGB(70, 40, 110), FogEnd = 700,
	AtmosphereColor = Color3.fromRGB(120, 80, 170), AtmosphereDensity = 0.48,
	AtmosphereHaze = 2.8, AtmosphereTint = Color3.fromRGB(190, 150, 255),
}

local function mushroom(parent: Instance, pos: Vector3, scale: number, color: Color3, rng: Random)
	local stemH = 12 * scale
	Build.part({
		Name = "Stem", Size = Vector3.new(4 * scale, stemH, 4 * scale),
		Color = Color3.fromRGB(238, 230, 210), Position = pos + Vector3.new(0, stemH / 2, 0), Shadow = true,
	}, parent)

	local capR = 13 * scale
	MapKit.bouncy(parent, CFrame.new(pos + Vector3.new(0, stemH + 2.4 * scale, 0)),
		Vector3.new(capR, 5 * scale, capR), color, 90 + 30 * scale)

	-- lunares neón
	for i = 1, 5 do
		local ang = (i / 5) * math.pi * 2 + rng:NextNumber(0, 1)
		Build.neon({
			Name = "Dot", Size = Vector3.new(2.4 * scale, 0.6, 2.4 * scale), CanCollide = false,
			Color = Palette.lighten(color, 0.35),
			Position = pos + Vector3.new(math.cos(ang) * capR * 0.3, stemH + 5 * scale, math.sin(ang) * capR * 0.3),
		}, parent)
	end
	local glow = parent:FindFirstChild("Dot")
	if glow and glow:IsA("BasePart") then Build.light(glow, color, 26, 2) end
end

function Map.Build(origin: Vector3, rng: Random): (Model, { CFrame })
	local model = Build.model("Map_" .. Map.Id)
	local grass = Map.Colors.Primary
	local magic = Map.Colors.Secondary
	local neon = Map.Colors.Accent

	-- Suelo del claro + anillo de hierba oscura
	Build.part({ Name = "Clearing", Size = Vector3.new(300, 8, 300), Color = grass,
		Position = origin + Vector3.new(0, 4, 0), Shadow = true }, model)
	Build.part({ Name = "Outer", Size = Vector3.new(340, 6, 340), Color = Palette.darken(grass, 0.16),
		Position = origin + Vector3.new(0, 1, 0) }, model)

	-- Laguna encantada central (brilla y empuja hacia arriba, no mata)
	Build.neon({ Name = "Pond", Size = Vector3.new(54, 1.2, 54), Color = magic, Transparency = 0.35,
		CanCollide = true, Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(origin + Vector3.new(0, 8.4, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, model)
	local pondLight = Build.neon({ Name = "PondCore", Size = Vector3.new(10, 10, 10), Color = magic,
		Transparency = 0.5, CanCollide = false, Shape = Enum.PartType.Ball,
		Position = origin + Vector3.new(0, 12, 0) }, model)
	Build.light(pondLight, magic, 60, 5)

	-- Setas rebotadoras
	for i = 1, 12 do
		local ang = (i / 12) * math.pi * 2 + rng:NextNumber(-0.25, 0.25)
		local r = rng:NextNumber(42, 128)
		local pos = origin + Vector3.new(math.cos(ang) * r, 8, math.sin(ang) * r)
		local color = Palette.pick({ magic, neon, Palette.Magenta, Palette.Turquoise, Palette.Orange }, rng)
		mushroom(model, pos, rng:NextNumber(0.8, 1.7), color, rng)
	end

	-- Plataformas de copa (3 alturas) sostenidas por troncos
	for i = 1, 8 do
		local ang = (i / 8) * math.pi * 2 + math.pi / 8
		local r = rng:NextNumber(55, 115)
		local h = 26 + (i % 3) * 16
		local pos = origin + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
		Build.part({ Name = "TreeTrunk", Size = Vector3.new(7, h, 7), Color = Color3.fromRGB(104, 72, 60),
			Position = pos + Vector3.new(0, h / 2 + 8, 0), Shadow = true }, model)
		Build.part({ Name = "CanopyDeck", Size = Vector3.new(26, 2.4, 26),
			Color = Palette.vary(neon, 0.06, 0.1, 0.12, rng),
			CFrame = CFrame.new(pos + Vector3.new(0, h + 9, 0)) * CFrame.Angles(0, ang, 0) }, model)
		Build.neon({ Name = "DeckEdge", Size = Vector3.new(27, 0.4, 27), Color = magic, CanCollide = false,
			Transparency = 0.3, Position = pos + Vector3.new(0, h + 10.4, 0) }, model)
	end

	-- Troncos caídos como cobertura
	for i = 1, 7 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(30, 130)
		local len = rng:NextNumber(18, 34)
		Build.part({
			Name = "FallenLog", Size = Vector3.new(len, 6, 6), Color = Color3.fromRGB(96, 66, 56),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(ang) * r, 11, math.sin(ang) * r))
				* CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
		}, model)
	end

	-- Árboles procedurales del generador compartido (misma estética que el lobby)
	for i = 1, 16 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(118, 158)
		TreeGenerator.create(
			origin + Vector3.new(math.cos(ang) * r, 8, math.sin(ang) * r),
			model,
			{ Seed = rng:NextInteger(1, 1e8), Color = Palette.pick({ magic, neon, Palette.Violet, Palette.Turquoise }, rng), Glow = true }
		)
	end

	-- Espinas venenosas en los bordes
	for i = 1, 10 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(135, 150)
		MapKit.hazard(model, CFrame.new(origin + Vector3.new(math.cos(ang) * r, 10, math.sin(ang) * r)),
			Vector3.new(10, 5, 10), Color3.fromRGB(120, 255, 120), 12,
			{ Name = "Thorns", Transparency = 0.2, CanCollide = false, Interval = 0.6 })
	end

	MapKit.totem(model, CFrame.new(origin + Vector3.new(0, 8, 125)), "BOSQUE ENCANTADO", neon)
	MapKit.voidPlane(model, origin, 900, -40)

	local spawns = MapKit.spawnRing(origin, 100, 12, 14)
	return model, spawns
end

return Map
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">MapKit</string>
          <ProtectedString name="Source"><![CDATA[--[[
	MapKit.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > MapKit   (ModuleScript)

	Piezas reutilizables para los generadores de mapas: plataformas, pilares,
	rampas, zonas de daño (tag "StudHazard"), trampolines (tag "StudBouncy"),
	islas flotantes y anillos de spawn.
]]

local Build = require(script.Parent.Parent.Build)
local Palette = require(script.Parent.Parent.Palette)

local MapKit = {}

MapKit.TAG_HAZARD = "StudHazard"
MapKit.TAG_BOUNCY = "StudBouncy"
MapKit.TAG_SPIN   = "StudSpin"

--- Plataforma Stud básica.
function MapKit.platform(parent: Instance, cf: CFrame, size: Vector3, color: Color3, opts: { [string]: any }?): BasePart
	local o = (opts or {}) :: any
	return Build.part({
		Name = o.Name or "Platform",
		Size = size, Color = color, CFrame = cf,
		Material = o.Material, Transparency = o.Transparency,
		Shadow = o.Shadow, Stud = o.Stud,
	}, parent)
end

--- Pilar con remate neón.
function MapKit.pillar(parent: Instance, base: Vector3, height: number, thickness: number, color: Color3, accent: Color3)
	Build.part({
		Name = "Pillar", Size = Vector3.new(thickness, height, thickness), Color = color,
		Position = base + Vector3.new(0, height / 2, 0), Shadow = true,
	}, parent)
	Build.neon({
		Name = "PillarTip", Size = Vector3.new(thickness * 0.7, 1.2, thickness * 0.7), Color = accent,
		Position = base + Vector3.new(0, height + 0.6, 0), CanCollide = false,
	}, parent)
end

--- Zona que hace daño (lava, hielo roto, arenas, láser...).
function MapKit.hazard(parent: Instance, cf: CFrame, size: Vector3, color: Color3, damage: number, opts: { [string]: any }?): BasePart
	local o = (opts or {}) :: any
	local part = Build.part({
		Name = o.Name or "Hazard",
		Size = size, Color = color, CFrame = cf,
		Material = o.Material or Enum.Material.Neon,
		Transparency = o.Transparency or 0.15,
		CanCollide = o.CanCollide == true,
		Stud = false,
		Attributes = { Damage = damage, Interval = o.Interval or 0.35, Knockback = o.Knockback or 0 },
		Tags = { MapKit.TAG_HAZARD },
	}, parent)
	return part
end

--- Trampolín / hongo rebotador.
function MapKit.bouncy(parent: Instance, cf: CFrame, size: Vector3, color: Color3, power: number): BasePart
	return Build.part({
		Name = "Bouncy", Size = size, Color = color, CFrame = cf,
		Material = Enum.Material.Neon, Stud = false,
		Attributes = { Power = power },
		Tags = { MapKit.TAG_BOUNCY },
	}, parent)
end

--- Rampa de acceso.
function MapKit.ramp(parent: Instance, cf: CFrame, size: Vector3, color: Color3): BasePart
	return Build.wedge({ Name = "Ramp", Size = size, Color = color, CFrame = cf }, parent)
end

--- Isla flotante con base piramidal invertida.
function MapKit.island(parent: Instance, center: Vector3, radius: number, thickness: number, top: Color3, bottom: Color3)
	Build.part({
		Name = "IslandTop", Size = Vector3.new(radius * 2, thickness, radius * 2),
		Color = top, Position = center, Shadow = true,
	}, parent)
	local layers = 3
	for i = 1, layers do
		local f = 1 - i / (layers + 0.6)
		Build.part({
			Name = "IslandBase",
			Size = Vector3.new(radius * 2 * f, thickness, radius * 2 * f),
			Color = Palette.darken(bottom, 0.06 * i),
			Position = center - Vector3.new(0, thickness * i, 0),
			CanCollide = false,
		}, parent)
	end
end

--- Escalera de bloques.
function MapKit.stairs(parent: Instance, start: CFrame, steps: number, stepSize: Vector3, color: Color3)
	for i = 1, steps do
		Build.part({
			Name = "Step", Size = stepSize, Color = Palette.vary(color, 0.01, 0.03, 0.05),
			CFrame = start * CFrame.new(0, stepSize.Y * (i - 0.5), -stepSize.Z * (i - 0.5)),
		}, parent)
	end
end

--- Muro perimetral invisible para que nadie caiga al vacío por error de diseño.
function MapKit.bounds(parent: Instance, center: Vector3, size: Vector3, height: number)
	local half = size / 2
	local sides = {
		{ Vector3.new(center.X, center.Y + height / 2, center.Z - half.Z), Vector3.new(size.X, height, 2) },
		{ Vector3.new(center.X, center.Y + height / 2, center.Z + half.Z), Vector3.new(size.X, height, 2) },
		{ Vector3.new(center.X - half.X, center.Y + height / 2, center.Z), Vector3.new(2, height, size.Z) },
		{ Vector3.new(center.X + half.X, center.Y + height / 2, center.Z), Vector3.new(2, height, size.Z) },
	}
	for _, s in ipairs(sides) do
		Build.part({
			Name = "Bound", Size = s[2], Position = s[1], Transparency = 1,
			CanCollide = true, Stud = false, CastShadow = false,
		}, parent)
	end
end

--- Plano de vacío: mata a quien cae fuera del mapa.
function MapKit.voidPlane(parent: Instance, center: Vector3, size: number, y: number)
	MapKit.hazard(parent, CFrame.new(center.X, y, center.Z), Vector3.new(size, 4, size),
		Color3.fromRGB(20, 20, 30), 9999, { Name = "Void", Transparency = 1, Interval = 0.1, Material = Enum.Material.SmoothPlastic })
end

--- Devuelve N CFrames en círculo mirando al centro, elevados `y`.
function MapKit.spawnRing(center: Vector3, radius: number, count: number, y: number): { CFrame }
	local out = {}
	for i = 1, count do
		local ang = (i / count) * math.pi * 2
		local pos = center + Vector3.new(math.cos(ang) * radius, y, math.sin(ang) * radius)
		table.insert(out, CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z)))
	end
	return out
end

--- Cartel holográfico / tótem temático del mapa.
function MapKit.totem(parent: Instance, cf: CFrame, text: string, color: Color3)
	Build.sign(cf * CFrame.new(0, 10, 0), text, { Width = 26, Height = 7, Color = Palette.Ink, Accent = color }, parent)
	Build.part({ Name = "TotemBase", Size = Vector3.new(6, 10, 6), Color = Palette.darken(color, 0.35), CFrame = cf * CFrame.new(0, 5, 0) }, parent)
end

return MapKit
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">MapRegistry</string>
          <ProtectedString name="Source"><![CDATA[--[[
	MapRegistry.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > MapRegistry   (ModuleScript)

	Índice de los 5 mapas temáticos. Para añadir un mapa nuevo basta con crear
	el ModuleScript con la misma interfaz (Id, Name, Theme, Colors, Lighting,
	Build(origin, rng) -> Model, spawns) y registrarlo aquí.
]]

local MapRegistry = {}

local modules = {
	require(script.Parent.VolcanicIsland),
	require(script.Parent.ArcticTemple),
	require(script.Parent.EnchantedForest),
	require(script.Parent.DesertRuins),
	require(script.Parent.CyberCity),
}

MapRegistry.List = modules

MapRegistry.ById = {}
for _, m in ipairs(modules) do
	MapRegistry.ById[m.Id] = m
end

--- Información ligera (sin funciones) para mandar a la UI de votación.
function MapRegistry.GetInfo(map): { [string]: any }
	return {
		Id = map.Id,
		Name = map.Name,
		Theme = map.Theme,
		Description = map.Description,
		Primary = map.Colors.Primary,
		Secondary = map.Colors.Secondary,
		Accent = map.Colors.Accent,
	}
end

--- N mapas distintos al azar, evitando repetir el último jugado.
function MapRegistry.PickOptions(count: number, excludeId: string?, rng: Random?)
	local r = rng or Random.new(os.clock() * 1e6)
	local pool = {}
	for _, m in ipairs(modules) do
		if m.Id ~= excludeId then table.insert(pool, m) end
	end
	-- Fisher-Yates
	for i = #pool, 2, -1 do
		local j = r:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local out = {}
	for i = 1, math.min(count, #pool) do
		table.insert(out, pool[i])
	end
	return out
end

return MapRegistry
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">VolcanicIsland</string>
          <ProtectedString name="Source"><![CDATA[--[[
	VolcanicIsland.lua — MAPA 1
	Ubicación en Roblox: ReplicatedStorage > Shared > Maps > VolcanicIsland   (ModuleScript)

	Tema: Isla Volcánica / Lava Stud.
	Mar de lava, volcán central con cráter, anillos de obsidiana, puentes
	colgantes y géiseres que hacen daño. Verticalidad media-alta.
]]

local Build = require(script.Parent.Parent.Build)
local Palette = require(script.Parent.Parent.Palette)
local MapKit = require(script.Parent.MapKit)

local Map = {}

Map.Id = "volcano"
Map.Name = "ISLA VOLCÁNICA"
Map.Theme = "Lava Stud"
Map.Description = "Roca negra, ríos de lava y géiseres. No toques el suelo naranja."
Map.Colors = {
	Primary = Color3.fromRGB(58, 44, 52),
	Secondary = Color3.fromRGB(255, 112, 32),
	Accent = Color3.fromRGB(255, 196, 40),
}
Map.Lighting = {
	ClockTime = 17.4, Brightness = 2.2,
	Ambient = Color3.fromRGB(78, 46, 40), OutdoorAmbient = Color3.fromRGB(120, 60, 40),
	FogColor = Color3.fromRGB(120, 48, 24), FogEnd = 900,
	AtmosphereColor = Color3.fromRGB(150, 70, 40), AtmosphereDensity = 0.42,
	AtmosphereHaze = 2.4, AtmosphereTint = Color3.fromRGB(255, 160, 110),
}

function Map.Build(origin: Vector3, rng: Random): (Model, { CFrame })
	local model = Build.model("Map_" .. Map.Id)
	local rock = Map.Colors.Primary
	local lava = Map.Colors.Secondary
	local ember = Map.Colors.Accent

	-- Mar de lava (una sola parte grande + daño)
	MapKit.hazard(model, CFrame.new(origin), Vector3.new(520, 6, 520), lava, 22, {
		Name = "LavaSea", Transparency = 0.05, CanCollide = true, Interval = 0.3,
	})

	-- Isla principal
	Build.part({ Name = "Island", Size = Vector3.new(300, 10, 300), Color = rock,
		Position = origin + Vector3.new(0, 7, 0), Shadow = true }, model)
	Build.part({ Name = "IslandRim", Size = Vector3.new(316, 4, 316), Color = Palette.darken(rock, 0.1),
		Position = origin + Vector3.new(0, 2, 0) }, model)

	-- Grietas de lava en el suelo (decorativas + daño leve)
	for i = 1, 7 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(40, 125)
		local pos = origin + Vector3.new(math.cos(ang) * dist, 12.2, math.sin(ang) * dist)
		MapKit.hazard(model, CFrame.new(pos) * CFrame.Angles(0, ang, 0),
			Vector3.new(rng:NextNumber(18, 46), 0.6, rng:NextNumber(6, 12)), lava, 10,
			{ Name = "Crack", Transparency = 0.1, Interval = 0.5 })
	end

	-- Volcán central escalonado + cráter
	local tiers = 6
	for i = 1, tiers do
		local w = 120 - i * 15
		Build.part({
			Name = "VolcanoTier", Size = Vector3.new(w, 9, w),
			Color = Palette.vary(rock, 0.01, 0.04, 0.05, rng),
			CFrame = CFrame.new(origin + Vector3.new(0, 12 + i * 8.5, 0)) * CFrame.Angles(0, math.rad(i * 9), 0),
			Shadow = i <= 2,
		}, model)
	end
	local craterY = 12 + tiers * 8.5 + 5
	MapKit.hazard(model, CFrame.new(origin + Vector3.new(0, craterY, 0)), Vector3.new(28, 3, 28), lava, 35,
		{ Name = "Crater", CanCollide = true, Transparency = 0, Interval = 0.25 })
	Build.neon({ Name = "CraterGlow", Size = Vector3.new(26, 60, 26), Color = ember, Transparency = 0.86,
		CanCollide = false, Position = origin + Vector3.new(0, craterY + 30, 0) }, model)
	Build.light(model:FindFirstChild("CraterGlow") :: BasePart, ember, 60, 4)

	-- Plataformas de obsidiana flotantes alrededor del cono
	for i = 1, 10 do
		local ang = (i / 10) * math.pi * 2
		local r = rng:NextNumber(62, 96)
		local y = 24 + rng:NextNumber(0, 34)
		local pos = origin + Vector3.new(math.cos(ang) * r, y, math.sin(ang) * r)
		Build.part({
			Name = "Obsidian", Size = Vector3.new(rng:NextNumber(16, 26), 3, rng:NextNumber(16, 26)),
			Color = Palette.darken(rock, 0.08), CFrame = CFrame.new(pos) * CFrame.Angles(0, ang, 0), Shadow = true,
		}, model)
		Build.neon({ Name = "Edge", Size = Vector3.new(4, 0.5, 4), Color = lava, CanCollide = false,
			Position = pos + Vector3.new(0, 1.8, 0), Transparency = 0.25 }, model)
	end

	-- Puentes de roca hacia el cono
	for i = 1, 4 do
		local ang = (i / 4) * math.pi * 2 + math.pi / 8
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		for s = 1, 7 do
			local pos = origin + dir * (44 + s * 8) + Vector3.new(0, 14 + s * 1.2, 0)
			Build.part({
				Name = "BridgePlank", Size = Vector3.new(9, 1.4, 8), Color = Palette.darken(rock, 0.04),
				CFrame = CFrame.new(pos) * CFrame.Angles(0, -ang, 0),
			}, model)
		end
	end

	-- Géiseres: columnas de lava intermitentes (tag hazard, animadas por el cliente)
	for i = 1, 6 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(50, 130)
		local pos = origin + Vector3.new(math.cos(ang) * r, 13, math.sin(ang) * r)
		Build.part({ Name = "GeyserBase", Size = Vector3.new(12, 2, 12), Color = Palette.darken(rock, 0.16), Position = pos }, model)
		MapKit.hazard(model, CFrame.new(pos + Vector3.new(0, 16, 0)), Vector3.new(7, 30, 7), ember, 18,
			{ Name = "GeyserJet", Transparency = 0.45, Interval = 0.4 })
	end

	-- Rocas y brasas decorativas
	for i = 1, 22 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(30, 142)
		local s = rng:NextNumber(3, 9)
		Build.part({
			Name = "Rock", Size = Vector3.new(s, s * rng:NextNumber(0.6, 1.3), s),
			Color = Palette.vary(rock, 0.02, 0.05, 0.08, rng),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(ang) * r, 12 + s / 2, math.sin(ang) * r))
				* CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2)),
		}, model)
	end

	MapKit.totem(model, CFrame.new(origin + Vector3.new(0, 12, 120)), "ISLA VOLCÁNICA", lava)
	MapKit.voidPlane(model, origin, 900, -40)

	local spawns = MapKit.spawnRing(origin, 112, 12, 16)
	return model, spawns
end

return Map
]]></ProtectedString>
        </Properties>
      </Item>

    </Item>
    <Item class="ModuleScript" referent="RBX10">
      <Properties>
        <string name="Name">Build</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Build.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Build   (ModuleScript)

	Fábrica de geometría. TODO el mundo (lobby, tiendas, huevos, mapas, tableros)
	se construye con estas funciones, así la estética Stud y los ajustes de
	rendimiento quedan centralizados.

	Reglas de rendimiento aplicadas por defecto:
	  · Anchored = true          (cero simulación de física)
	  · CastShadow = false       (las sombras se activan solo donde aportan)
	  · Studs reales en 6 caras  (StudMaterial)
]]

local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local StudMaterial = require(script.Parent.StudMaterial)
local Palette = require(script.Parent.Palette)

local Build = {}

local RESERVED = {
	Class = true, CFrame = true, Position = true, Stud = true,
	Attributes = true, Tags = true, Parent = true, Shadow = true,
}

--- Crea una BasePart con estética Stud.
-- props admite cualquier propiedad de Part + claves especiales:
--   Class="WedgePart"|"Part"|"TrussPart", Stud=false (caras lisas),
--   Shadow=true, Attributes={}, Tags={}
function Build.part(props: { [string]: any }?, parent: Instance?): BasePart
	props = props or {}
	local part = Instance.new((props :: any).Class or "Part") :: BasePart
	part.Anchored = true
	part.CanCollide = true
	part.CastShadow = false
	part.Size = Vector3.new(4, 1, 4)
	part.Color = Palette.White
	part.Material = StudMaterial.Material

	for key, value in pairs(props :: any) do
		if not RESERVED[key] then
			(part :: any)[key] = value
		end
	end

	if (props :: any).Shadow then part.CastShadow = true end

	if (props :: any).Stud == false then
		StudMaterial.smooth(part)
	else
		StudMaterial.apply(part)
	end

	if (props :: any).CFrame then
		part.CFrame = (props :: any).CFrame
	elseif (props :: any).Position then
		part.Position = (props :: any).Position
	end

	if (props :: any).Attributes then
		for k, v in pairs((props :: any).Attributes) do
			part:SetAttribute(k, v)
		end
	end
	if (props :: any).Tags then
		for _, tag in ipairs((props :: any).Tags) do
			CollectionService:AddTag(part, tag)
		end
	end

	part.Parent = parent
	return part
end

--- Parte neón (sin studs, con brillo limpio).
function Build.neon(props: { [string]: any }?, parent: Instance?): BasePart
	props = props or {}
	;(props :: any).Material = Enum.Material.Neon
	;(props :: any).Stud = false
	return Build.part(props, parent)
end

--- Cilindro (eje X). Para postes usa CFrame * CFrame.Angles(0,0,math.rad(90)).
function Build.cylinder(props: { [string]: any }?, parent: Instance?): BasePart
	props = props or {}
	local p = Build.part(props, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end

--- Esfera / elipsoide (usa SpecialMesh para permitir escala no uniforme).
function Build.sphere(props: { [string]: any }?, parent: Instance?, meshScale: Vector3?): BasePart
	local p = Build.part(props, parent)
	p.Shape = Enum.PartType.Ball
	if meshScale then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = meshScale
		mesh.Parent = p
	end
	return p
end

function Build.wedge(props: { [string]: any }?, parent: Instance?): BasePart
	props = props or {}
	;(props :: any).Class = "WedgePart"
	return Build.part(props, parent)
end

--- Modelo vacío con nombre.
function Build.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Build.folder(name: string, parent: Instance?): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

--- PointLight optimizado (rango corto, sin sombras).
function Build.light(parent: Instance, color: Color3, range: number?, brightness: number?): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range or 22
	l.Brightness = brightness or 2.4
	l.Shadows = false
	l.Parent = parent
	return l
end

--- Farol stud completo: poste + bombilla neón + luz.
function Build.lamp(cf: CFrame, color: Color3, parent: Instance?, height: number?): Model
	local h = height or 14
	local model = Build.model("Lamp", parent)

	Build.part({
		Name = "Base", Size = Vector3.new(3, 1, 3), Color = Palette.Ink,
		CFrame = cf * CFrame.new(0, 0.5, 0),
	}, model)

	Build.part({
		Name = "Post", Size = Vector3.new(1, h, 1), Color = Palette.darken(color, 0.4),
		CFrame = cf * CFrame.new(0, h / 2 + 1, 0),
	}, model)

	local bulb = Build.neon({
		Name = "Bulb", Size = Vector3.new(2.4, 2.4, 2.4), Color = color,
		CFrame = cf * CFrame.new(0, h + 1.8, 0), CanCollide = false,
	}, model)
	Build.light(bulb, color, 30, 3)

	Build.part({
		Name = "Cap", Size = Vector3.new(3.4, 0.8, 3.4), Color = Palette.Ink,
		CFrame = cf * CFrame.new(0, h + 3.4, 0), CanCollide = false,
	}, model)

	model.PrimaryPart = model:FindFirstChild("Post") :: BasePart
	return model
end

--- Letrero con SurfaceGui (texto nítido, sin assets externos).
function Build.sign(cf: CFrame, text: string, opts: { [string]: any }?, parent: Instance?): BasePart
	opts = opts or {}
	local o = opts :: any
	local width  = o.Width or 18
	local height = o.Height or 5
	local color  = o.Color or Palette.Ink
	local accent = o.Accent or Palette.Cyan

	local board = Build.part({
		Name = o.Name or "Sign",
		Size = Vector3.new(width, height, 0.8),
		Color = color, CFrame = cf, CanCollide = false,
	}, parent)

	-- marco neón
	Build.neon({
		Name = "Frame", Size = Vector3.new(width + 0.8, height + 0.8, 0.5),
		Color = accent, CFrame = cf * CFrame.new(0, 0, -0.2), CanCollide = false,
		Transparency = 0.15,
	}, board)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.PixelsPerStud or 36
	gui.LightInfluence = 0
	gui.MaxDistance = o.MaxDistance or 180
	gui.Parent = board

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = o.Font or Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = o.TextColor or Palette.White
	label.TextScaled = true
	label.RichText = true
	label.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Palette.darken(accent, 0.45)
	stroke.Parent = label

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(o.TextColor or Palette.White, accent)
	grad.Rotation = 90
	grad.Parent = label

	return board
end

--- ProximityPrompt estándar del juego.
function Build.prompt(parent: BasePart, actionText: string, objectText: string, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = distance or 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = parent
	return prompt
end

--- Suelo en damero de baldosas Stud (pocas partes grandes = buen FPS).
function Build.checkerFloor(center: Vector3, size: Vector3, tile: number, a: Color3, b: Color3, parent: Instance?): Folder
	local folder = Build.folder("Floor", parent)
	local cols = math.max(1, math.floor(size.X / tile))
	local rows = math.max(1, math.floor(size.Z / tile))
	local startX = center.X - (cols * tile) / 2 + tile / 2
	local startZ = center.Z - (rows * tile) / 2 + tile / 2

	for ix = 0, cols - 1 do
		for iz = 0, rows - 1 do
			local even = (ix + iz) % 2 == 0
			Build.part({
				Name = "Tile",
				Size = Vector3.new(tile, size.Y, tile),
				Color = even and a or b,
				Position = Vector3.new(startX + ix * tile, center.Y - size.Y / 2, startZ + iz * tile),
			}, folder)
		end
	end
	return folder
end

--- Camino de baldosas entre dos puntos.
function Build.path(from: Vector3, to: Vector3, width: number, colorA: Color3, colorB: Color3, parent: Instance?): Folder
	local folder = Build.folder("Path", parent)
	local delta = to - from
	local length = delta.Magnitude
	local steps = math.max(1, math.floor(length / width))
	local dir = delta.Unit
	for i = 0, steps - 1 do
		local pos = from + dir * (i * width + width / 2)
		Build.part({
			Name = "PathTile",
			Size = Vector3.new(width, 0.4, width),
			Color = (i % 2 == 0) and colorA or colorB,
			CFrame = CFrame.lookAt(Vector3.new(pos.X, from.Y + 0.2, pos.Z), Vector3.new(pos.X, from.Y + 0.2, pos.Z) + dir),
			CanCollide = false,
		}, folder)
	end
	return folder
end

--- Anillo decorativo de bloques (plazas, pedestales, arenas).
function Build.ring(center: Vector3, radius: number, count: number, blockSize: Vector3, color: Color3, parent: Instance?): Folder
	local folder = Build.folder("Ring", parent)
	for i = 1, count do
		local ang = (i / count) * math.pi * 2
		local pos = center + Vector3.new(math.cos(ang) * radius, 0, math.sin(ang) * radius)
		Build.part({
			Name = "RingBlock", Size = blockSize, Color = color,
			CFrame = CFrame.new(pos) * CFrame.Angles(0, -ang, 0),
		}, folder)
	end
	return folder
end

--- Arco de entrada stud.
function Build.arch(cf: CFrame, width: number, height: number, color: Color3, accent: Color3, parent: Instance?): Model
	local m = Build.model("Arch", parent)
	for _, side in ipairs({ -1, 1 }) do
		Build.part({
			Size = Vector3.new(3, height, 3), Color = color,
			CFrame = cf * CFrame.new(side * width / 2, height / 2, 0),
		}, m)
	end
	Build.part({
		Size = Vector3.new(width + 3, 3, 3.4), Color = color,
		CFrame = cf * CFrame.new(0, height + 1.5, 0),
	}, m)
	Build.neon({
		Size = Vector3.new(width - 1, 0.8, 1.2), Color = accent, CanCollide = false,
		CFrame = cf * CFrame.new(0, height - 0.4, 0),
	}, m)
	return m
end

--- Limpieza garantizada (nunca dejar basura en Workspace).
function Build.destroyIn(inst: Instance, seconds: number)
	Debris:AddItem(inst, seconds)
end

--- Texto flotante 3D (BillboardGui) reutilizable.
function Build.billboard(adornee: Instance, text: string, opts: { [string]: any }?): BillboardGui
	opts = opts or {}
	local o = opts :: any
	local bb = Instance.new("BillboardGui")
	bb.Name = o.Name or "Billboard"
	bb.Adornee = adornee :: any
	bb.Size = o.Size or UDim2.new(0, 220, 0, 55)
	bb.StudsOffset = o.StudsOffset or Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = o.AlwaysOnTop ~= false
	bb.MaxDistance = o.MaxDistance or 60
	bb.LightInfluence = 0
	bb.Parent = o.Parent or adornee

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = o.Font or Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.RichText = true
	label.TextColor3 = o.TextColor or Palette.White
	label.Parent = bb

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = o.StrokeThickness or 2.5
	stroke.Color = o.StrokeColor or Palette.Ink
	stroke.Parent = label

	return bb
end

return Build
