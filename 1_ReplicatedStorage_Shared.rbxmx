	List = {
		{ Id = "coinrain", Name = "LLUVIA DE MONEDAS", Desc = "Recoge studs dorados que caen del cielo",
		  Color = Color3.fromRGB(255, 205, 55),  Ambient = "gold" },
		{ Id = "eggfest",  Name = "FIESTA DE HUEVOS",  Desc = "Huevos a mitad de precio",
		  Color = Color3.fromRGB(120, 255, 170), Ambient = "green" },
		{ Id = "storm",    Name = "TORMENTA STUD",     Desc = "Rayos constantes sobre el lobby",
		  Color = Color3.fromRGB(0, 225, 255),   Ambient = "storm" },
		{ Id = "disco",    Name = "FIESTA NEÓN",       Desc = "El lobby cambia de color al ritmo",
		  Color = Color3.fromRGB(255, 80, 220),  Ambient = "disco" },
	},
}

-- ───────────────────────────────── LOBBY (geometría) ─────────────────────────
Config.Lobby = {
	Origin      = Vector3.new(0, 0, 0),
	FloorSize   = Vector3.new(440, 4, 320),
	TileSize    = 40,
	WallHeight  = 14,
	SpawnZ      = 118,          -- zona de aparición (sur)
	BoardsZ     = -132,         -- zona de leaderboards (norte)
	ShopX       = 168,          -- tiendas laterales
	EggZone     = Vector3.new(-96, 0, -48),
	EventStage  = Vector3.new(104, 0, -40),
	MapOrigin   = Vector3.new(0, 1200, 0), -- los mapas se construyen muy lejos del lobby
}

return Config
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX12">
      <Properties>
        <string name="Name">Format</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Format.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Format   (ModuleScript)

	Formateo de números, tiempo y texto para UI y leaderboards.
]]

local Format = {}

--- 1234567 -> "1,234,567"
function Format.comma(n: number): string
	local s = tostring(math.floor(n))
	local sign = ""
	if s:sub(1, 1) == "-" then sign, s = "-", s:sub(2) end
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	out = out:gsub("^,", "")
	return sign .. out
end

--- 1534 -> "1.5K" / 2400000 -> "2.4M"
function Format.short(n: number): string
	local abs = math.abs(n)
	if abs >= 1e9 then return string.format("%.1fB", n / 1e9) end
	if abs >= 1e6 then return string.format("%.1fM", n / 1e6) end
	if abs >= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end

--- Segundos -> "12h 34m"
function Format.hours(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	if h >= 1000 then
		return Format.comma(h) .. "h"
	end
	return string.format("%dh %02dm", h, m)
end

--- Segundos -> "02:35"
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

--- 1 -> "#1"
function Format.rank(n: number): string
	return "#" .. tostring(n)
end

--- Escapa texto de usuario para RichText (evita inyección de etiquetas).
function Format.escapeRich(text: string): string
	text = text:gsub("&", "&amp;")
	text = text:gsub("<", "&lt;")
	text = text:gsub(">", "&gt;")
	text = text:gsub('"', "&quot;")
	return text
end

--- Color3 -> "rgb(255,0,0)" para RichText
function Format.richColor(c: Color3): string
	return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

--- Envuelve texto en una etiqueta de color RichText.
function Format.colored(text: string, color: Color3, bold: boolean?): string
	local inner = bold and ("<b>" .. text .. "</b>") or text
	return string.format('<font color="%s">%s</font>', Format.richColor(color), inner)
end

return Format
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX13">
      <Properties>
        <string name="Name">Net</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Net.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Net   (ModuleScript)

	Capa de red mínima: crea (servidor) y resuelve (cliente) los Remotes dentro
	de ReplicatedStorage/Remotes. Un único punto de verdad para los nombres.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.EventNames = {
	"SpawnVFX",     -- S->C : reproducir rayo + impacto en una posición
	"RoundState",   -- S->C : estado del ciclo de rondas + temporizador
	"VoteOptions",  -- S->C : mapas candidatos
	"VoteTally",    -- S->C : conteo de votos
	"CastVote",     -- C->S : votar un mapa
	"Announce",     -- S->C : banner grande en pantalla
	"SystemChat",   -- S->C : mensaje de sistema con RichText en el chat
	"DataSync",     -- S->C : snapshot de datos del jugador
	"EggVFX",       -- S->C : efecto de apertura de huevo (para los de alrededor)
	"CombatVFX",    -- S->C : disparo del blaster
	"LobbyEvent",   -- S->C : evento dinámico del lobby
	"KillFeed",     -- S->C : feed de eliminaciones
	"ClientReady",  -- C->S : la pantalla de carga terminó, cargar personaje
	"Toast",        -- S->C : notificación pequeña
}

Net.FunctionNames = {
	"Purchase",     -- C->S : comprar en tienda
	"OpenEgg",      -- C->S : abrir huevo (servidor decide la recompensa)
	"GetBootInfo",  -- C->S : estado de carga del mundo + datos iniciales
	"GetLeaderboard", -- C->S : copia cacheada de un Top 100
}

local folder: Folder? = nil

--- Servidor: crea la carpeta Remotes y todos los objetos.
function Net.Init()
	assert(RunService:IsServer(), "Net.Init solo se llama en el servidor")
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
	end
	for _, name in ipairs(Net.EventNames) do
		if not f:FindFirstChild(name) then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = f
		end
	end
	for _, name in ipairs(Net.FunctionNames) do
		if not f:FindFirstChild(name) then
			local e = Instance.new("RemoteFunction")
			e.Name = name
			e.Parent = f
		end
	end
	folder = f
	return f
end

local function getFolder(): Folder
	if folder then return folder end
	folder = ReplicatedStorage:WaitForChild("Remotes", 30) :: Folder
	return folder
end

function Net.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name, 20) :: RemoteEvent
end

function Net.Func(name: string): RemoteFunction
	return getFolder():WaitForChild(name, 20) :: RemoteFunction
end

--- Atajo servidor: dispara a todos salvo a uno.
function Net.FireAllExcept(name: string, except: Player, ...)
	local Players = game:GetService("Players")
	local ev = Net.Event(name)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= except then
			ev:FireClient(p, ...)
		end
	end
end

return Net
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX14">
      <Properties>
        <string name="Name">Palette</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Palette.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Palette   (ModuleScript)

	Paleta vibrante y utilidades de color (variación de tono, mezcla, gradientes).
	Todos los colores del lobby, árboles y mapas salen de aquí para mantener
	una estética equilibrada.
]]

local Palette = {}

local C3 = Color3.fromRGB

-- Colores base vivos
Palette.Lime      = C3(154, 255, 60)
Palette.Turquoise = C3(0, 226, 205)
Palette.Orange    = C3(255, 146, 30)
Palette.Yellow    = C3(255, 215, 50)
Palette.Magenta   = C3(255, 70, 190)
Palette.Violet    = C3(165, 90, 255)
Palette.Cyan      = C3(0, 205, 255)
Palette.Red       = C3(255, 75, 95)
Palette.Blue      = C3(70, 130, 255)
Palette.Green     = C3(60, 210, 110)
Palette.White     = C3(248, 250, 255)
Palette.Ink       = C3(28, 32, 48)
Palette.Deep      = C3(18, 20, 34)
Palette.Gold      = C3(255, 199, 44)
Palette.Silver    = C3(208, 216, 230)
Palette.Bronze    = C3(205, 127, 50)

-- Copas de árbol (lo que pidió el brief: lima, turquesa, naranja, amarillo, magenta, violeta)
Palette.Canopy = {
	Palette.Lime, Palette.Turquoise, Palette.Orange,
	Palette.Yellow, Palette.Magenta, Palette.Violet,
	C3(120, 255, 190), C3(255, 110, 120),
}

-- Troncos
Palette.Trunk = {
	C3(126, 84, 56), C3(96, 70, 52), C3(150, 104, 70), C3(84, 64, 96),
}

-- Suelo del lobby (damero suave)
Palette.FloorA = C3(74, 198, 255)
Palette.FloorB = C3(56, 168, 232)
Palette.PathA  = C3(255, 221, 102)
Palette.PathB  = C3(255, 196, 70)
Palette.Grass  = C3(96, 220, 120)
Palette.GrassAlt = C3(76, 198, 106)

-- Acentos neón
Palette.Neon = { Palette.Cyan, Palette.Magenta, Palette.Lime, Palette.Yellow, Palette.Violet }

--- Devuelve un elemento aleatorio de una lista de colores.
function Palette.pick(list: { Color3 }, rng: Random?): Color3
	local r = rng or Random.new()
	return list[r:NextInteger(1, #list)]
end

--- Varía un color en HSV (tono/saturación/brillo) para dar riqueza sin romper la armonía.
function Palette.vary(color: Color3, hueAmt: number?, satAmt: number?, valAmt: number?, rng: Random?): Color3
	local r = rng or Random.new()
	local h, s, v = color:ToHSV()
	h = (h + r:NextNumber(-(hueAmt or 0.03), hueAmt or 0.03)) % 1
	s = math.clamp(s + r:NextNumber(-(satAmt or 0.08), satAmt or 0.08), 0, 1)
	v = math.clamp(v + r:NextNumber(-(valAmt or 0.10), valAmt or 0.10), 0.08, 1)
	return Color3.fromHSV(h, s, v)
end

--- Mezcla lineal entre dos colores.
function Palette.mix(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

--- Versión más oscura (para bordes/sombras stud).
function Palette.darken(color: Color3, amount: number?): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, math.min(1, s + 0.05), math.max(0.05, v - (amount or 0.25)))
end

--- Versión más clara (para brillos/neón).
function Palette.lighten(color: Color3, amount: number?): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, math.max(0, s - 0.10), math.min(1, v + (amount or 0.22)))
end

--- Color de rango para el Top 3 físico y títulos.
function Palette.rankColor(rank: number): Color3
	if rank == 1 then return Palette.Gold end
	if rank == 2 then return Palette.Silver end
	if rank == 3 then return Palette.Bronze end
	return C3(120, 132, 158)
end

--- Arcoíris determinista (para gradientes de UI y eventos neón).
function Palette.rainbow(t: number): Color3
	return Color3.fromHSV(t % 1, 0.85, 1)
end

return Palette
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX15">
      <Properties>
        <string name="Name">StudMaterial</string>
        <ProtectedString name="Source"><![CDATA[--[[
	StudMaterial.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > StudMaterial   (ModuleScript)

	NOTA TÉCNICA IMPORTANTE
	-----------------------
	El motor actual de Roblox NO expone `Enum.Material.Stud` como material.
	El look clásico de "studs" se consigue con `Enum.SurfaceType.Studs` en las
	6 caras de la parte (sigue existiendo en el motor aunque ya no aparezca en
	el panel de propiedades desde 2019).

	Este módulo resuelve el material "Stud" de forma segura y en este orden:
	  1) Enum.Material.Stud          -> si tu versión del motor lo expone (pcall)
	  2) MaterialVariant "Stud"      -> si creaste un MaterialVariant con ese nombre
	  3) Plastic + SurfaceType.Studs -> studs AUTÉNTICOS del motor (por defecto)

	Así el 100% del juego mantiene la estética Stud pedida, sin romperse nunca.
]]

local MaterialService = game:GetService("MaterialService")

local StudMaterial = {}

-- 1) ¿Existe Enum.Material.Stud en este motor?
local okEnum, enumStud = pcall(function()
	return (Enum.Material :: any).Stud
end)

StudMaterial.HasNativeStudMaterial = okEnum and typeof(enumStud) == "EnumItem"
StudMaterial.Material = StudMaterial.HasNativeStudMaterial and enumStud or Enum.Material.Plastic

-- 2) ¿Hay un MaterialVariant llamado "Stud"? (opcional, para texturas HD de studs)
StudMaterial.Variant = ""
do
	local ok = pcall(function()
		for _, child in ipairs(MaterialService:GetChildren()) do
			if child:IsA("MaterialVariant") and child.Name == "Stud" then
				StudMaterial.Variant = "Stud"
			end
		end
	end)
	if not ok then StudMaterial.Variant = "" end
end

local STUDS = Enum.SurfaceType.Studs
local SMOOTH = Enum.SurfaceType.Smooth

local SURFACE_PROPS = { "TopSurface", "BottomSurface", "LeftSurface", "RightSurface", "FrontSurface", "BackSurface" }

--- Aplica los studs reales a las 6 caras de una parte.
function StudMaterial.apply(part: BasePart, faces: { string }?)
	if not part:IsA("BasePart") then return end

	-- No ponemos studs en neón / vidrio / fuerza: arruina el brillo limpio.
	local m = part.Material
	if m == Enum.Material.Neon or m == Enum.Material.Glass or m == Enum.Material.ForceField then
		StudMaterial.smooth(part)
		return
	end

	if m == Enum.Material.Plastic or m == StudMaterial.Material then
		part.Material = StudMaterial.Material
		if StudMaterial.Variant ~= "" then
			pcall(function() part.MaterialVariant = StudMaterial.Variant end)
		end
	end

	local list = faces or SURFACE_PROPS
	for _, prop in ipairs(list) do
		pcall(function() (part :: any)[prop] = STUDS end)
	end
end

--- Deja todas las caras lisas (neón, cristal, detalles finos).
function StudMaterial.smooth(part: BasePart)
	for _, prop in ipairs(SURFACE_PROPS) do
		pcall(function() (part :: any)[prop] = SMOOTH end)
	end
end

--- Studs solo arriba (suelos/caminos: menos ruido visual, mismo estilo).
function StudMaterial.applyTop(part: BasePart)
	StudMaterial.smooth(part)
	part.Material = StudMaterial.Material
	part.TopSurface = STUDS
end

--- Convierte un modelo entero al estilo Stud.
function StudMaterial.applyToModel(model: Instance)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			StudMaterial.apply(d)
		end
	end
end

return StudMaterial
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX16">
      <Properties>
        <string name="Name">Titles</string>
        <ProtectedString name="Source"><![CDATA[--[[
	Titles.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > Titles   (ModuleScript)

	Definición de los títulos 3D exclusivos del Top 1 / 2 / 3 de cada categoría,
	más el título genérico de Top 100. Cada entrada define texto, gradiente
	(UIGradient), color de borde (UIStroke) y si lleva brillo animado.
]]

local Titles = {}

local C3 = Color3.fromRGB

Titles.Definitions = {
	Kills = {
		[1] = { Text = "☠ VERDUGO SUPREMO",  A = C3(255, 70, 70),  B = C3(255, 210, 60),  Stroke = C3(90, 10, 10),  Glow = true },
		[2] = { Text = "⚔ CAZADOR DE ÉLITE", A = C3(255, 150, 120), B = C3(230, 235, 255), Stroke = C3(70, 30, 30) },
		[3] = { Text = "🔥 DEPREDADOR",      A = C3(255, 120, 60),  B = C3(205, 127, 50),  Stroke = C3(70, 35, 10) },
	},
	Streak = {
		[1] = { Text = "⚡ RACHA IMPARABLE",  A = C3(0, 240, 255),  B = C3(170, 110, 255), Stroke = C3(8, 40, 70),  Glow = true },
		[2] = { Text = "✦ INVICTO",          A = C3(120, 220, 255), B = C3(235, 245, 255), Stroke = C3(15, 45, 70) },
		[3] = { Text = "◆ EN LLAMAS",        A = C3(80, 200, 220),  B = C3(205, 127, 50),  Stroke = C3(20, 50, 60) },
	},
	Playtime = {
		[1] = { Text = "⏳ LEYENDA ETERNA",   A = C3(190, 110, 255), B = C3(255, 205, 55),  Stroke = C3(45, 15, 75), Glow = true },
		[2] = { Text = "★ VETERANO",         A = C3(200, 170, 255), B = C3(235, 240, 255), Stroke = C3(45, 25, 75) },
		[3] = { Text = "✧ HABITUAL",         A = C3(170, 150, 230), B = C3(205, 127, 50),  Stroke = C3(40, 25, 60) },
	},
}

Titles.Top100 = { Text = "◈ TOP 100", A = C3(120, 255, 180), B = C3(0, 210, 255), Stroke = C3(10, 50, 45) }

Titles.CategoryNames = {
	Kills = "KILLS",
	Streak = "RACHA",
	Playtime = "HORAS JUGADAS",
}

--- Devuelve la definición de título para una categoría y puesto (nil si > 3).
function Titles.Get(category: string, rank: number)
	local cat = Titles.Definitions[category]
	if not cat then return nil end
	return cat[rank]
end

--- Elige el mejor título disponible entre varias categorías.
-- ranks = { Kills = 2, Streak = 57, Playtime = 1 }
function Titles.Best(ranks: { [string]: number })
	local bestDef, bestRank, bestCat = nil, 999, nil
	for category, rank in pairs(ranks) do
		if rank and rank <= 3 and rank < bestRank then
			local def = Titles.Get(category, rank)
			if def then
				bestDef, bestRank, bestCat = def, rank, category
			end
		end
	end
	return bestDef, bestCat, bestRank
end

return Titles
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX17">
      <Properties>
        <string name="Name">TreeGenerator</string>
        <ProtectedString name="Source"><![CDATA[--[[
	TreeGenerator.lua
	Ubicación en Roblox: ReplicatedStorage > Shared > TreeGenerator   (ModuleScript)

	Generador procedural de árboles estilo Stud.
	5 arquetipos geométricos × colores vibrantes × variación de tono y escala.
	Cada árbol usa entre 4 y 11 partes (presupuesto de FPS controlado).
]]

local Build = require(script.Parent.Build)
local Palette = require(script.Parent.Palette)

local TreeGenerator = {}

export type TreeOptions = {
	Seed: number?,
	Scale: number?,
	Color: Color3?,
	Variant: string?,
	Glow: boolean?,
}

local VARIANTS = { "cone", "cubes", "orb", "layers", "spiral" }

local function trunk(parent: Instance, base: CFrame, height: number, thickness: number, rng: Random): CFrame
	local color = Palette.vary(Palette.pick(Palette.Trunk, rng), 0.02, 0.06, 0.08, rng)
	Build.part({
		Name = "Trunk",
		Size = Vector3.new(thickness, height, thickness),
		Color = color,
		CFrame = base * CFrame.new(0, height / 2, 0),
		Shadow = true,
	}, parent)
	return base * CFrame.new(0, height, 0)
end

--- Copa cónica: cubos decrecientes rotados (clásico stud).
local function canopyCone(parent, top: CFrame, scale: number, color: Color3, rng: Random)
	local layers = rng:NextInteger(3, 4)
	for i = 1, layers do
		local t = (i - 1) / layers
		local w = (12 - i * 2.4) * scale
		Build.part({
			Name = "Canopy",
			Size = Vector3.new(w, 3.2 * scale, w),
			Color = Palette.vary(color, 0.025, 0.08, 0.10 - t * 0.04, rng),
			CFrame = top * CFrame.new(0, (i - 0.5) * 3.0 * scale, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(-25, 25)), 0),
			CanCollide = false,
			Shadow = i == 1,
		}, parent)
	end
end

--- Copa de cubos sueltos (estilo juguete).
local function canopyCubes(parent, top: CFrame, scale: number, color: Color3, rng: Random)
	local count = rng:NextInteger(4, 6)
	for i = 1, count do
		local ang = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local r = rng:NextNumber(1.6, 4.2) * scale
		local size = rng:NextNumber(4.5, 7.5) * scale
		Build.part({
			Name = "Canopy",
			Size = Vector3.new(size, size * 0.8, size),
			Color = Palette.vary(color, 0.04, 0.10, 0.12, rng),
			CFrame = top * CFrame.new(math.cos(ang) * r, rng:NextNumber(1.5, 5) * scale, math.sin(ang) * r)
				* CFrame.Angles(0, math.rad(rng:NextNumber(0, 90)), 0),
			CanCollide = false,
		}, parent)
	end
end

--- Copa esférica (mesh sphere para escala no uniforme).
local function canopyOrb(parent, top: CFrame, scale: number, color: Color3, rng: Random)
	local d = rng:NextNumber(10, 14) * scale
	Build.part({
		Name = "Canopy",
		Size = Vector3.new(d, d * rng:NextNumber(0.75, 1.05), d),
		Color = Palette.vary(color, 0.03, 0.08, 0.10, rng),
		CFrame = top * CFrame.new(0, d * 0.45, 0),
		CanCollide = false,
		Shape = Enum.PartType.Ball,
		Shadow = true,
	}, parent)
	Build.part({
		Name = "CanopyTop",
		Size = Vector3.new(d * 0.55, d * 0.5, d * 0.55),
		Color = Palette.lighten(color, 0.12),
		CFrame = top * CFrame.new(rng:NextNumber(-1, 1), d * 0.85, rng:NextNumber(-1, 1)),
		CanCollide = false,
		Shape = Enum.PartType.Ball,
	}, parent)
end

--- Copa en losas apiladas y giradas.
local function canopyLayers(parent, top: CFrame, scale: number, color: Color3, rng: Random)
	local layers = rng:NextInteger(3, 4)
	for i = 1, layers do
		local w = (14 - i * 2.6) * scale
		Build.part({
			Name = "Canopy",
			Size = Vector3.new(w, 1.8 * scale, w),
			Color = Palette.vary(color, 0.05, 0.10, 0.14, rng),
			CFrame = top * CFrame.new(0, (i - 0.5) * 2.6 * scale, 0) * CFrame.Angles(0, math.rad(i * 22), 0),
			CanCollide = false,
		}, parent)
	end
end

--- Copa en espiral ascendente (muy vistosa en el lobby).
local function canopySpiral(parent, top: CFrame, scale: number, color: Color3, rng: Random)
	local steps = rng:NextInteger(5, 7)
	for i = 1, steps do
		local t = i / steps
		local ang = t * math.pi * 3
		local w = (9 - t * 5) * scale
		Build.part({
			Name = "Canopy",
			Size = Vector3.new(w, 2 * scale, w),
			Color = Palette.mix(color, Palette.lighten(color, 0.25), t),
			CFrame = top * CFrame.new(math.cos(ang) * 2.2 * scale, i * 2.1 * scale, math.sin(ang) * 2.2 * scale)
				* CFrame.Angles(0, -ang, 0),
			CanCollide = false,
		}, parent)
	end
end

local CANOPIES = {
	cone = canopyCone, cubes = canopyCubes, orb = canopyOrb,
	layers = canopyLayers, spiral = canopySpiral,
}

--- Crea un árbol Stud en `position`.
function TreeGenerator.create(position: Vector3, parent: Instance?, options: TreeOptions?): Model
	local opt = options or {}
	local rng = Random.new(opt.Seed or (os.clock() * 1e6) % 2147483647)
	local scale = opt.Scale or rng:NextNumber(0.75, 1.45)
	local variant = opt.Variant or VARIANTS[rng:NextInteger(1, #VARIANTS)]
	local color = opt.Color or Palette.pick(Palette.Canopy, rng)

	local model = Build.model("StudTree_" .. variant, parent)
	model:SetAttribute("Variant", variant)

	local base = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local trunkHeight = rng:NextNumber(7, 13) * scale
	local top = trunk(model, base, trunkHeight, rng:NextNumber(1.6, 2.6) * scale, rng)

	local fn = CANOPIES[variant] or canopyCone
	fn(model, top, scale, color, rng)

	-- Brillo opcional: una baya neón que ilumina de noche sin costar FPS.
	if opt.Glow or rng:NextNumber() < 0.28 then
		local orb = Build.neon({
			Name = "Glow",
			Size = Vector3.new(1.6, 1.6, 1.6),
			Color = Palette.lighten(color, 0.3),
			CFrame = top * CFrame.new(rng:NextNumber(-3, 3), rng:NextNumber(2, 6) * scale, rng:NextNumber(-3, 3)),
			CanCollide = false,
			Shape = Enum.PartType.Ball,
		}, model)
		Build.light(orb, color, 16, 1.6)
	end

	local primary = model:FindFirstChild("Trunk")
	if primary and primary:IsA("BasePart") then
		model.PrimaryPart = primary
	end
	return model
end

--- Siembra un bosque evitando una zona central (plazas) y respetando un presupuesto.
function TreeGenerator.forest(parent: Instance, opts: {
	Count: number, Center: Vector3, RangeX: number, RangeZ: number,
	Avoid: { { Pos: Vector3, Radius: number } }?, Seed: number?, Y: number?,
}): Folder
	local folder = Build.folder("StudTrees", parent)
	local rng = Random.new(opts.Seed or 20261124)
	local placed = {}
	local attempts = 0
	local y = opts.Y or 0

	while #placed < opts.Count and attempts < opts.Count * 14 do
		attempts += 1
		local pos = Vector3.new(
			opts.Center.X + rng:NextNumber(-opts.RangeX, opts.RangeX),
			y,
			opts.Center.Z + rng:NextNumber(-opts.RangeZ, opts.RangeZ)
		)

		local ok = true
		if opts.Avoid then
			for _, zone in ipairs(opts.Avoid) do
				if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(zone.Pos.X, 0, zone.Pos.Z)).Magnitude < zone.Radius then
					ok = false
					break
				end
			end
		end
		if ok then
			for _, other in ipairs(placed) do
				if (pos - other).Magnitude < 17 then ok = false break end
			end
		end

		if ok then
			table.insert(placed, pos)
			TreeGenerator.create(pos, folder, { Seed = rng:NextInteger(1, 1e8) })
		end
	end
	return folder
end

return TreeGenerator
]]></ProtectedString>
